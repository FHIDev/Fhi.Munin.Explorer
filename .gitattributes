# Normalise line endings so a Linux CI runner and a Windows dev machine agree.
* text=auto

*.cs        text diff=csharp
*.razor     text
*.csproj    text
*.props     text
*.slnx      text
*.md        text
*.json      text
*.config    text
*.yml       text
*.ps1       text
# LF always: CI runs this on ubuntu and git bash chokes on a CRLF shebang line.
*.sh        text eol=lf

*.png binary
*.jpg binary
*.woff binary
*.woff2 binary
