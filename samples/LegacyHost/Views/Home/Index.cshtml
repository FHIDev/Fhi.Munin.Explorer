@using Fhi.Munin.Explorer.Blazor
@using LegacyHost.Components
@{
    ViewData["Title"] = "Legacy host";
}

<div class="hostchrome">
    <p class="hostchrome-note">
        This page is plain MVC. Everything inside the frame below is the
        <code>Fhi.Munin.Explorer.Blazor</code> package, mounted the way helsedata's
        Optimizely CMS mounts Blazor components — a <code>&lt;component&gt;</code> tag helper
        in a Razor view, with no router and no <code>@@rendermode</code>.
    </p>
    <p class="hostchrome-note">
        The package ships a second root component beside this one — <code>KildeExplorer</code>, the
        kildeutforsker. It has a route of its own: <a href="/kilder">kilder</a>.
    </p>
</div>

<div class="hostframe">
    @* render-mode is set HERE, by the host. The component itself is render-mode free.
       Server (not ServerPrerendered) because the component fetches on initialise and
       prerendering would run that twice.

       The wrapper, not the explorer directly: the package has no router and never touches the
       address bar, so mirroring state into the URL is the host's job. The query string is read
       here, server-side, and handed in — which is what makes a shared link work on first paint
       rather than after a round trip. *@
    <component type="typeof(ExplorerWithUrlState)"
               render-mode="Server"
               param-Language="@("no")"
               param-InitialQuery="@Context.Request.QueryString.Value" />
</div>
