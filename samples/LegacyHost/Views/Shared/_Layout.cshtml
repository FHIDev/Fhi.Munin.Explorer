<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Munin Explorer legacy host</title>
    @* In the real host this is Fhi.Helsedata.Stiler:
         <link rel="stylesheet" href="~/_content/Fhi.Helsedata.Stiler/css/main.css" />
       The RCL ships no CSS of its own, so a sample host has to bring some. This one is a
       stand-in that styles the same class names Stiler will. *@
    <link rel="stylesheet" href="~/css/host.css" />
</head>
<body>
    <header class="hostbar">
        <strong>LegacyHost</strong>
        <span>MVC + AddServerSideBlazor + MapBlazorHub — mirrors helsedata's Optimizely setup</span>
    </header>

    <main class="hostmain">
        @RenderBody()
    </main>

    @* Shown by blazor.server.js when the circuit fails; without it a failed page just stops answering. *@
    <div id="blazor-error-ui" role="alert"
         style="display: none; position: fixed; inset: auto 0 0 0; z-index: 10001; padding: 1rem 1.5rem; background: #1a1a2e; color: #fff;">
        Noe gikk galt, og siden svarer ikke lenger.
        <a href="" class="reload" style="color: #fff; text-decoration: underline; margin-left: 0.5rem;">Last inn på nytt</a>
    </div>
    @* Legacy Blazor Server: blazor.server.js, not blazor.web.js. *@
    <script src="_framework/blazor.server.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
