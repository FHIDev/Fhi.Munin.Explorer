@using Fhi.Munin.Explorer.Blazor
@using Fhi.Munin.Explorer.Contracts
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Nav

@* The host half of the shareable-state contract, and the whole of it.

   The package has no router and never touches the address bar — the host owns the URL, so this is
   where a shared link is read and written. helsedata can copy this file nearly verbatim; it is the
   reference implementation as much as it is the sample.

   What used to be here — parsing five parameters, validating two enums, and restating the
   component's page-size default to know what to leave out — is now ExplorerUrlState in the package.
   What is left is the part only a host can know: which query it was opened with, and when to write
   the address bar. *@

<VariableExplorer @bind-Search="_state.Search"
                  @bind-Filter="_state.Filter"
                  @bind-Sort="_state.Sort"
                  @bind-Direction="_state.Direction"
                  @bind-Page="_state.Page"
                  @bind-PageSize="_state.PageSize"
                  Language="@Language" />

@code {
    /// <summary>The query string the page was opened with, read server-side by the view.</summary>
    [Parameter] public string? InitialQuery { get; set; }

    [Parameter] public string Language { get; set; } = "no";

    // A mutable holder, because @bind- needs settable properties and the state itself is a record.
    private Binding _state = new();

    // What the address bar already says. Without it every render would call into JS to write the
    // URL it is already showing.
    private string? _mirrored;

    protected override void OnInitialized() => _state = Binding.From(ExplorerUrlState.Parse(InitialQuery));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var query = _state.ToState().ToQueryString();

        // "?x=1" to set, and the path itself to clear: assigning "" would leave the previous query
        // string in place, so clearing every filter would not clear the URL.
        //
        // The path from NavigationManager rather than a literal "/". replaceState writes an absolute
        // path, and this component does not know where the host mounted it — behind a reverse proxy
        // or in a virtual directory, "/" would send the reader out of the application entirely.
        var url = query.Length == 0 ? new Uri(Nav.Uri).AbsolutePath : "?" + query;

        if (url == _mirrored)
        {
            return;
        }

        _mirrored = url;

        // replaceState, not pushState: opening and closing filters would otherwise fill the history
        // with steps the reader has to walk back through one at a time instead of leaving the site.
        await JS.InvokeVoidAsync("history.replaceState", null, "", url);
    }

    /// <summary>The state as separate settable properties, which is what <c>@@bind-</c> needs.</summary>
    private sealed class Binding
    {
        public string? Search { get; set; }
        public VariableFilter Filter { get; set; } = VariableFilter.None;
        public SortField Sort { get; set; } = SortField.Default;
        public SortDirection Direction { get; set; } = SortDirection.Ascending;
        public int Page { get; set; } = 1;
        public int PageSize { get; set; } = ExplorerUrlState.DefaultPageSize;

        public static Binding From(ExplorerUrlState state) => new()
        {
            Search = state.Search,
            Filter = state.Filter,
            Sort = state.Sort,
            Direction = state.Direction,
            Page = state.Page,
            PageSize = state.PageSize,
        };

        public ExplorerUrlState ToState() => new()
        {
            Search = Search,
            Filter = Filter,
            Sort = Sort,
            Direction = Direction,
            Page = Page,
            PageSize = PageSize,
        };
    }
}
