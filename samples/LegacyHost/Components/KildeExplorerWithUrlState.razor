@using Fhi.Munin.Explorer.Blazor
@using Fhi.Munin.Explorer.Contracts
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Nav

@* The kilde half of the shareable-state contract, beside ExplorerWithUrlState.

   Deliberately far smaller than its sibling, and that is the component's contract rather than a
   shortcut taken here. KildeExplorer has no SearchChanged, no sort, no pager and no facet
   callbacks: search, filters and column choices are Kelda parity decisions that stay component
   state and go away on refresh. The one thing worth putting in a host's URL is which kilde is
   open, so that is the one thing bound both ways — and the only thing read out of the URL.

   ?search= is deliberately not honoured, though KildeExplorer.Search would accept it. Reading it
   would make the parameter look supported while BuildQuery, which has no SearchChanged to follow,
   erased it from the address bar on the first render after load. The link would work exactly once
   and could not be shared onward. A parameter this host cannot maintain is one it should not take,
   so the URL here carries the open kilde and nothing else. *@

<KildeExplorer @bind-SelectedKildeId="_selectedKildeId"
               ExploreVariablesRequested="ExploreVariables"
               Language="@Language" />

@code {
    /// <summary>The query string the page was opened with, read server-side by the view.</summary>
    [Parameter] public string? InitialQuery { get; set; }

    /// <summary>The path this component is mounted on, read server-side by the view.</summary>
    /// <remarks>
    /// ExplorerWithUrlState can hard-code "/" for the empty query because it only ever sits on the
    /// front page. This one never does, so closing the open kilde has to restore the path it was
    /// reached on — writing "/" would navigate the reader off the page they were reading.
    /// <para>
    /// Handed in rather than named here because there is more than one: the host answers this view
    /// on both /kilder, which is the path ModernHost routes with <c>@@page</c>, and /Home/Kilder,
    /// which the default controller route gives it for free. A constant would be wrong on whichever
    /// of the two the reader did not use.
    /// </para>
    /// </remarks>
    [Parameter] public string? BasePath { get; set; }

    [Parameter] public string Language { get; set; } = "no";

    private Guid? _selectedKildeId;

    // What the address bar already says. Without it every render would call into JS to write
    // the URL it is already showing.
    private string? _mirrored;

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(InitialQuery ?? "");

        // A kilde id in a URL is whatever a stranger typed. One that does not parse opens the list,
        // and one that parses but names nothing the API publishes opens a view that says so — the
        // component's own documented behaviour, so nothing has to be validated here.
        if (query.TryGetValue("kilde", out var kilde) && Guid.TryParse(kilde.ToString(), out var parsed))
        {
            _selectedKildeId = parsed;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var query = BuildQuery();

        if (query == _mirrored)
        {
            return;
        }

        _mirrored = query;

        // replaceState, not pushState, for the reason ExplorerWithUrlState gives: opening and
        // closing kilder would otherwise fill the history with steps the reader has to walk back
        // through one at a time instead of leaving the site.
        await JS.InvokeVoidAsync("history.replaceState", null, "", query);
    }

    /// <summary>Turn the chosen kilder into the query the variable explorer reads, and go there.</summary>
    /// <remarks>
    /// The host's job: only it knows where the other explorer is mounted. An empty list means the
    /// reader narrowed nothing, so it lands unfiltered. forceLoad because this host has no router.
    /// (Fhi.Metadata-5ghur)
    /// </remarks>
    private void ExploreVariables(IReadOnlyList<Guid> kildeIds)
    {
        var query = new VariableFilter { KildeIds = kildeIds }.ToQueryString();

        Nav.NavigateTo(query.Length == 0 ? "/" : "/?" + query, forceLoad: true);
    }

    private string BuildQuery()
    {
        // The open kilde is the whole of it — see the file header for why search is neither read
        // in nor written out. Everything this returns is a URL the reader can share and reopen.
        return _selectedKildeId is { } id
            ? "?kilde=" + Uri.EscapeDataString(id.ToString())
            : string.IsNullOrEmpty(BasePath) ? "/" : BasePath;
    }
}
