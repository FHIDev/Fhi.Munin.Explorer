@inherits LayoutComponentBase

@* Same chrome as LegacyHost's _Layout.cshtml, so the two samples are told apart by the banner
   rather than by guesswork. *@
<header class="hostbar">
    <strong>ModernHost</strong>
    <span>Blazor Web App + AddRazorComponents + MapRazorComponents&lt;App&gt; — the everyday development host</span>
</header>

<main class="hostmain">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
