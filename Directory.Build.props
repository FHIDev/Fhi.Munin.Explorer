<Project>

  <!-- TFM and language settings live here only — never in the individual csproj files,
       so there is one place to change them. Matches the Fhi.Helsedata.Soknader convention. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Package identity and version.

       Deliberately 0.x. A 1.0.0 is a stability promise, and a published version cannot be
       walked back: the feed does allow one to be deleted, but whoever already restored it keeps
       what they got. We stay below 1.0 until a real
       consumer (the helsedata POC) is wired up and the API surface has stopped moving.
       The publish pipeline overrides this from the release tag with -p:Version=. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Folkehelseinstituttet (FHI)</Authors>
    <Company>Folkehelseinstituttet</Company>

    <!-- Required of an FHI package, and the one piece of provenance a consumer sees on the
         feed without opening anything: it names who stands behind the package beside the
         author and the licence. -->
    <Copyright>Copyright 2026 Folkehelseinstituttet (FHI)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/FHIDev/Fhi.Munin.Explorer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FHIDev/Fhi.Munin.Explorer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Not the notes themselves, and not editable per release: this default is for local and CI
         builds, which are not published. The release workflow overrides it below with the
         version's own changelog section, which it assembles before it packs. -->
    <PackageReleaseNotes>Unreleased build. Release notes for published versions: https://github.com/FHIDev/Fhi.Munin.Explorer/releases</PackageReleaseNotes>
  </PropertyGroup>

  <!-- The release workflow writes this version's assembled changelog section to a file and points
       PackageReleaseNotesFile at it, so the feed shows the entry rather than a link to go and find
       one. Through a file because release notes are multi-line and full of semicolons, and an
       MSBuild command-line property loses the first and splits on the second. -->
  <PropertyGroup Condition="'$(PackageReleaseNotesFile)' != '' AND Exists('$(PackageReleaseNotesFile)')">
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText('$(PackageReleaseNotesFile)'))</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Ship the XML docs. The point of this package is that a helsedata developer does not
       have to guess how it behaves, and several of the rules that matter — the token provider
       must be singleton-safe, must not touch IHttpContextAccessor — are only written down in
       the doc comments. Without this they stop at our repo boundary. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing comment on a public member) is off deliberately. Turning it on adds
         226 errors, nearly all of them DTO properties that mirror the Explorer API field for
         field — Id, Name, Count. A one-line comment restating the property name is not
         documentation, and the meaning of those fields lives in the API contract, not here.
         Suppressing it ships the prose that carries real information and leaves the obvious
         members bare, rather than trading the former away to avoid the latter. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Sample hosts and tests are never published. -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('ModernHost')) OR
                            $(MSBuildProjectName.StartsWith('LegacyHost')) OR
                            $(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Portability guard, RCL only.

       The Munin explorer ships as a Razor Class Library that has to render inside
       helsedata.no's Optimizely CMS (legacy Blazor Server: AddServerSideBlazor +
       MapBlazorHub) as well as a modern Blazor Web App. Anything host-specific that
       leaks into the component breaks one of those hosts, usually at runtime and
       usually only for some users.

       BannedApiAnalyzers turns that from a review question into a build error (RS0030).
       Scoped to the RCL: the sample hosts are *supposed* to use host-specific types.

       The name in the condition is load-bearing and has been wrong once. It read
       'Fhi.Munin.Explorer.Blazor' from before the three projects were merged into one, and
       matched nothing afterwards — so the analyzer was never referenced, BannedSymbols.txt was
       never an AdditionalFile, and RS0030 could not fire. The guard was off for as long as that
       lasted, silently, which is the failure mode it exists to prevent. If the RCL is ever
       renamed again, this line moves with it.

       That last sentence is a request, and a request is what failed the first time, so it is no
       longer the only thing holding this up: scripts/assert-portability-guard-armed.sh builds the
       RCL against a file using a banned symbol and fails unless RS0030 is reported. It runs on
       every PR as the "portability guard armed" job. Break any part of this ItemGroup and that
       check goes red — which is the whole difference between this guard and the one that was
       quietly off. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Fhi.Munin.Explorer'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

</Project>
