<Project>

  <!-- TFM and language settings live here only — never in the individual csproj files,
       so there is one place to change them. Matches the Fhi.Helsedata.Soknader convention. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Package identity and version.

       Deliberately 0.x. A 1.0.0 on nuget.org is a stability promise, and published
       versions cannot be withdrawn — only unlisted. We stay below 1.0 until a real
       consumer (the helsedata POC) is wired up and the API surface has stopped moving.
       The publish pipeline overrides this from the release tag with -p:Version=. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Folkehelseinstituttet (FHI)</Authors>
    <Company>Folkehelseinstituttet</Company>

    <!-- Required of a public FHI package, and the one piece of provenance a consumer sees on
         nuget.org without opening anything: it names who stands behind the package beside the
         author and the licence. -->
    <Copyright>Copyright 2026 Folkehelseinstituttet (FHI)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/FHIDev/Fhi.Munin.Explorer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FHIDev/Fhi.Munin.Explorer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Not the notes themselves: nuget.org renders this per version, and pasting a version's
         entry in here would mean editing this file every release and being wrong the first time
         someone forgot.

         This default is for local and CI builds, which are not published. The release workflow
         overrides it with the GitHub release for the tag being packed - see the Pack step. That
         matters because nuget.org shows this string forever against that one version: a link to
         the changelog on main would, after the next release, point an old package at notes that
         no longer describe it and may not mention it at all. -->
    <PackageReleaseNotes>Unreleased build. Release notes for published versions: https://github.com/FHIDev/Fhi.Munin.Explorer/releases</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Ship the XML docs. The point of this package is that a helsedata developer does not
       have to guess how it behaves, and several of the rules that matter — the token provider
       must be singleton-safe, must not touch IHttpContextAccessor — are only written down in
       the doc comments. Without this they stop at our repo boundary. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing comment on a public member) is off deliberately. Turning it on adds
         226 errors, nearly all of them DTO properties that mirror the Explorer API field for
         field — Id, Name, Count. A one-line comment restating the property name is not
         documentation, and the meaning of those fields lives in the API contract, not here.
         Suppressing it ships the prose that carries real information and leaves the obvious
         members bare, rather than trading the former away to avoid the latter. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Sample hosts and tests are never published. -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('ModernHost')) OR
                            $(MSBuildProjectName.StartsWith('LegacyHost')) OR
                            $(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Portability guard, RCL only.

       The Munin explorer ships as a Razor Class Library that has to render inside
       helsedata.no's Optimizely CMS (legacy Blazor Server: AddServerSideBlazor +
       MapBlazorHub) as well as a modern Blazor Web App. Anything host-specific that
       leaks into the component breaks one of those hosts, usually at runtime and
       usually only for some users.

       BannedApiAnalyzers turns that from a review question into a build error (RS0030).
       Scoped to the RCL: the sample hosts are *supposed* to use host-specific types. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Fhi.Munin.Explorer.Blazor'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

</Project>
