<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!-- Fhi.Helsedata.Stiler comes from helsedata's internal Azure Artifacts feed and is
         needed once the styling work starts (bead Fhi.Metadata-l9l2n.17). To enable:

         <add key="Fhi.Helsedata.no"
              value="https://pkgs.dev.azure.com/fhi/Fhi.Helsedata/_packaging/Fhi.Helsedata.no/nuget/v3/index.json" />

         ...and add a packageSourceMapping entry for Fhi.Helsedata.Stiler. The feed is
         private, so restore needs credentials, and container builds must pass the token as
         a BuildKit secret — never as a build argument, which persists in image history.

         Keep <auditSources> clamped to nuget.org when you do. NuGet's vulnerability audit
         queries EVERY configured source regardless of packageSourceMapping, so a
         token-less restore against the private feed raises NU1900 — which
         TreatWarningsAsErrors then escalates into a build failure. helsedata hit exactly
         this and fixed it the same way. -->
  </packageSources>

  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
