<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!-- helsedata's internal Azure Artifacts feed. The only package taken from it is
         Fhi.Helsedata.Stiler, and the only project referencing it is samples/HostileHost —
         the fixture that renders the component against helsedata's REAL stylesheet rather
         than a stand-in (bead Fhi.Metadata-l9l2n.40).

         The feed is private, so restoring that project needs credentials. Everything else
         here restores from nuget.org alone, and the packageSourceMapping below is what
         keeps it that way: NuGet consults only the sources whose patterns match the package
         id, so a restore that never asks for Fhi.Helsedata.* never contacts this feed and
         never needs a token. That is also why HostileHost is deliberately NOT in
         Fhi.Munin.Explorer.slnx — a root `dotnet restore` would otherwise drag the private
         feed into every build.

         Credentials, both forms, and BOTH need the Azure Artifacts Credential Provider —
         a plugin under ~/.nuget/plugins that NuGet shells out to. NuGet itself reads
         neither of the things below; without the plugin it restores anonymously and the
         feed answers NU1301, which reads like a missing package:
           - local: the provider exchanges your az login for a feed token silently;
           - CI: the provider reads VSS_NUGET_EXTERNAL_FEED_ENDPOINTS, carrying a PAT from a
             repository secret. A GitHub-hosted runner has no provider, so the workflow
             installs one before restoring. A container build must pass the token as a
             BuildKit secret, never as a build argument — that persists in image history. -->
    <add key="Fhi.Helsedata.no"
         value="https://pkgs.dev.azure.com/fhi/Fhi.Helsedata/_packaging/Fhi.Helsedata.no/nuget/v3/index.json" />
  </packageSources>

  <!-- Which source each package may come from. `*` on nuget.org and the narrower
       Fhi.Helsedata.* on the private feed together mean one source is consulted per package
       and never both. Remove this and every build on every machine starts asking an
       authenticated feed about packages it does not host. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Fhi.Helsedata.no">
      <package pattern="Fhi.Helsedata.*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Clamped to nuget.org, and it must stay clamped. NuGet's vulnerability audit queries
       EVERY configured source regardless of packageSourceMapping, so a token-less restore
       against the private feed raises NU1900 — which TreatWarningsAsErrors in
       Directory.Build.props then escalates into a build failure. helsedata hit exactly this
       and fixed it the same way. -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
