<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Fhi.Munin.Explorer.Contracts\Fhi.Munin.Explorer.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- The client and its handler are internal on purpose — a host talks to IMuninExplorerClient.
         The tests still need to drive them directly against a stub HttpMessageHandler. -->
    <InternalsVisibleTo Include="Fhi.Munin.Explorer.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <Description>Typed HTTP client for the Munin Explorer API, and the AddMuninExplorer registration that wires it up. Calls are anonymous by default; register an IMuninExplorerTokenProvider before AddMuninExplorer and the user's access token is forwarded on every request. This is the data half of Fhi.Munin.Explorer.Blazor — install both to render the component.</Description>
    <PackageTags>munin;fhi;helsedata;metadata;variabler;http-client</PackageTags>
  </PropertyGroup>

</Project>
