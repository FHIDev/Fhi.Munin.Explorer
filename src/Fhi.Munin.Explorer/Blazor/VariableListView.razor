@namespace Fhi.Munin.Explorer.Blazor
@using Fhi.Munin.Explorer.Contracts

@* A shared list takes the view, signed in or out, and is read-only — see SharedListView. *@
@if (ShowsSharedList)
{
    @SharedListView
}
@* Signed out there is nothing else here at all — not an empty frame, not a sign-in prompt this
   package has no business wording. The host knows how its readers sign in; the package does not. *@
else if (State?.IsAuthenticated == true)
{
    @* Still the version, and still on the root: a host may mount this view on a page of its own,
       and a version readable on two of the three mount points is a trap for whoever checks the
       third. (Fhi.Metadata-sqbei) *@
    <DetailPage ViewRoot="" ViewMain=""
                Eyebrow="@ShownListEyebrow"
                Actions="@(HasActions ? ActionRow : null)"
                data-munin-explorer-version="@ExplorerVersion.Current">
        <Header>
            @* The chassis's own header name: the other three wear a prefixed one beside it and this
               view has none to wear. *@
            <div class="munin-explorer-page__header">
                @DetailBlocks.Heading(TitleLevel, ShownListName, "headline headline-s margin--bottom",
                                      ListHeadingId)

                @* The count off the same field the picker's options read, beside the day the
                   list last changed — see the remarks on ListMeta. *@
                @if (ListMeta is { } meta)
                {
                    <p class="caption">@meta</p>
                }
            </div>
        </Header>
        <ChildContent>

            @* helsedata's own variants: primary for the one action that makes something new,
               ghost-blue for the rest. Create and rename were standing forms and are disclosures. *@
            <div>
                <button class="hd-button-square button-square--primary"
                        type="button"
                        id="@CreateToggleId"
                        aria-expanded="@Expanded(_creating)"
                        @ref="_createToggle"
                        @onclick="ToggleCreatingFromControl">@T.AddNewList</button>

                @* Never disabled: it acts on no list, so an empty one does not stand in its way. *@
                <button class="hd-button-square button-square--ghost-blue"
                        type="button"
                        id="@OpenSharedToggleId"
                        aria-expanded="@Expanded(_openingShared)"
                        @onclick="ToggleOpeningSharedFromControl">@T.OpenSharedList</button>

                @* These act on the list on screen, so none is drawn when there is none. *@
                @if (_shownList is not null)
                {
                    <button class="hd-button-square button-square--ghost-blue"
                            type="button"
                            id="@RenameToggleId"
                            aria-expanded="@Expanded(_renaming)"
                            @ref="_renameToggle"
                            @onclick="ToggleRenamingFromControl">@T.RenameList</button>

                    @* Refused on an empty list the way sharing is, and described by the same reason. *@
                    <button class="hd-button-square button-square--ghost-blue"
                            type="button"
                            id="@CopyToggleId"
                            aria-expanded="@Expanded(_copying)"
                            aria-disabled="@AriaDisabled(!ShownListIsEmpty)"
                            aria-describedby="@(ShownListIsEmpty ? ListEmptyReasonId : null)"
                            @onclick="ToggleCopyingFromControl">@T.CopyList</button>

                    @* Two steps because the API offers no undo, and in the page rather than a JS
                       confirm a host's CSP may suppress. One control, so neither step removes the
                       element under the reader's focus. Ghost, not ghost-blue: it destroys something. *@
                    <button class="hd-button-square button-square--ghost"
                            type="button"
                            id="@DeleteButtonId"
                            aria-expanded="@Expanded(_confirmingDelete)"
                            @onclick="ToggleConfirmingDeleteFromControl">
                        @(_confirmingDelete ? T.ConfirmDeleteNo : T.DeleteList)
                    </button>

                    @if (_confirmingDelete)
                    {
                        @* The question describes the button that acts on it rather than being announced
                           on its own: a role="alert" inserted and filled in one update is announced
                           unreliably, which the alert region below is already shaped around. *@
                        <span id="@ConfirmDeleteId">@T.ConfirmDeleteList</span>
                        <button class="hd-button-square button-square--ghost"
                                type="button"
                                aria-describedby="@ConfirmDeleteId"
                                @onclick="DeleteListAsync">@T.ConfirmDeleteYes</button>
                    }

                    @* The delete control's shape, for the rows rather than the list. *@
                    <button class="hd-button-square button-square--ghost"
                            type="button"
                            id="@EmptyButtonId"
                            aria-expanded="@Expanded(_confirmingEmpty)"
                            aria-disabled="@AriaDisabled(!ShownListIsEmpty)"
                            aria-describedby="@(ShownListIsEmpty ? ListEmptyReasonId : null)"
                            @onclick="ToggleConfirmingEmptyFromControl">
                        @(_confirmingEmpty ? T.ConfirmEmptyNo : T.EmptyListAction)
                    </button>

                    @if (_confirmingEmpty)
                    {
                        <span id="@ConfirmEmptyId">@T.ConfirmEmptyList</span>
                        <button class="hd-button-square button-square--ghost"
                                type="button"
                                aria-describedby="@ConfirmEmptyId"
                                @onclick="EmptyListAsync">@T.ConfirmEmptyYes</button>
                    }

                    @* The reason is visible and wired by aria-describedby rather than a title
                       tooltip, which a keyboard reader never sees. aria-disabled for the reason the
                       create button gives; ToggleSharingFromControl refuses the press. *@
                    <button class="hd-button-square button-square--ghost-blue"
                            type="button"
                            id="@ShareToggleId"
                            aria-expanded="@Expanded(_sharingList)"
                            aria-disabled="@AriaDisabled(!ShownListIsEmpty)"
                            aria-describedby="@(ShownListIsEmpty ? ListEmptyReasonId : null)"
                            @onclick="ToggleSharingFromControl">@T.ShareList</button>

                    @* The refused buttons' reason. Hidden to sight, not removed, while the sentence below
                       says the same, so it is said once and the buttons still describe themselves. *@
                    @if (ShownListIsEmpty)
                    {
                        <span id="@ListEmptyReasonId" class="@(ListEmptySaidBelow ? "screenreader-only" : null)">@T.ListIsEmpty</span>
                    }
                }
            </div>

            @if (_openingShared)
            {
                <div>
                    <label class="form-element__label" for="@SharedCodeFieldId">@T.SharedListCodeLabel</label>
                    <input type="text"
                           id="@SharedCodeFieldId"
                           autocomplete="off"
                           @bind="_sharedCodeInput"
                           @bind:event="onchange" />
                    <button class="hd-button-square button-square--ghost-blue"
                            type="button"
                            aria-disabled="@AriaDisabled(_sharedCodeInput.Trim().Length > 0)"
                            @onclick="OpenSharedFromFieldAsync">@T.OpenSharedListSubmit</button>
                </div>
            }

            @* Read-only inputs rather than text, so the code and the link can be selected whole. *@
            @if (_sharingList && _shareMade is { } made && made.ListId == _shownList)
            {
                <div>
                    <label class="form-element__label" for="@ShareCodeFieldId">@T.ShareCodeLabel</label>
                    <input type="text" id="@ShareCodeFieldId" readonly value="@made.Code" />

                    @if (made.Link is { } link)
                    {
                        <label class="form-element__label" for="@ShareLinkFieldId">@T.ShareLinkLabel</label>
                        <input type="text" id="@ShareLinkFieldId" readonly value="@link" />
                    }

                    <p class="caption">@T.ShareValidity</p>
                    <a href="@ShareMailTo(made)">@T.ShareByEmail</a>
                </div>
            }

            @* Revealed by the button above and folded once the list is made. The reader is standing on
               the button inside it, so TakeFocusTarget moves focus to the picker that now names the list
               rather than letting the fold drop it to <body>. *@
            @if (_creating)
            {
                <div>
                    @* A real label, never a placeholder: no accessible name, and gone the moment the
                       reader types (WCAG 4.1.2, 3.3.2). The id is per-mount, or two mounts name one
                       field twice. onchange, never oninput — a round trip per keystroke on a circuit. *@
                    <div class="input__container">
                        <label class="form-element__label" for="@NewListNameId">@T.NewListName</label>
                        <input type="text"
                               class="input__field input__field--small"
                               id="@NewListNameId"
                               @bind="_newName"
                               @bind:event="onchange" />
                    </div>

                    @* aria-disabled rather than disabled: it becomes unavailable the moment a
                       successful create clears the name, and disabling the element that has focus
                       drops focus to <body>. CreateListAsync already refuses an empty name, so the
                       press is inert. *@
                    @* Solid, so it reads as the form's action; primary is "Legg til ny liste" above it. *@
                    <button class="hd-button-square button-square--secondary margin-top"
                            type="button"
                            aria-disabled="@AriaDisabled(_newName.Trim().Length > 0)"
                            @onclick="CreateListAsync">@T.CreateList</button>
                </div>
            }

            @if (_renaming && _shownList is not null)
            {
                <div>
                    <div class="input__container">
                        <label class="form-element__label" for="@RenameListNameId">@T.RenameListName</label>
                        <input type="text"
                               class="input__field input__field--small"
                               id="@RenameListNameId"
                               @bind="_renameName"
                               @bind:event="onchange" />
                    </div>
                    <button class="hd-button-square button-square--secondary margin-top"
                            type="button"
                            aria-disabled="@AriaDisabled(_renameName.Trim().Length > 0)"
                            @onclick="RenameListAsync">@T.SaveListName</button>
                </div>
            }

            @* The same shape again, with the refusal the shared list's save gives a name in use. *@
            @if (_copying && _shownList is not null)
            {
                <div>
                    <label class="form-element__label" for="@CopyListNameId">@T.CopyListName</label>
                    <input type="text"
                           id="@CopyListNameId"
                           aria-invalid="@(CopyNameMessage is null ? null : "true")"
                           aria-describedby="@CopyNameDescribedBy"
                           @bind="_copyName"
                           @bind:event="onchange" />
                    <button class="hd-button-square button-square--ghost-blue"
                            type="button"
                            aria-disabled="@AriaDisabled(!_copyInFlight)"
                            @onclick="CopyListAsync">@T.CopyListSubmit</button>

                    <p class="caption" id="@CopyNoteId">@T.CopyListLeavesDesiredData</p>
                    <p id="@CopyNameProblemId" role="alert">@CopyNameMessage</p>
                </div>
            }

            @* Always in the DOM, empty when nothing is wrong — a role="alert" inserted and filled in the
               same update is announced unreliably. Same shape as the explorer's own alert region. *@
            <div role="alert" aria-live="assertive" aria-atomic="true">
                @* A paragraph, so the sentence keeps its distance from the buttons above it. *@
                @if (AlertText is { } alert)
                {
                    <p>@alert</p>
                }

                @* In the region, so the failure and the way out are one utterance; the search's retry does the same.
                   Its own block; the top margin only while no sentence stands above it to give the gap. *@
                @if (_retryingLists || ListsFailureShown)
                {
                    <div>
                        <button class="hd-button-square button-square--secondary @(AlertText is null ? "margin-top " : "")margin-right margin-bottom munin-explorer-retry"
                                type="button"
                                aria-disabled="@AriaDisabled(ListsFailureShown)"
                                aria-label="@T.RetryListsName"
                                @onclick="RetryListsAsync">@T.RetryLists</button>
                    </div>
                }
            </div>

            @* A refused annotation gets its own region, because it outlasts whatever the reader does
               next: the field stays marked invalid until that row is written again, and sharing the
               region above would let a download or a rename failure take the sentence away and leave
               the mark unexplained (WCAG 3.3.1). The refused field points here by id. *@
            <div role="alert" aria-live="assertive" aria-atomic="true" id="@DesiredDataRefusalId">
                @DesiredDataRefusalMessage
            </div>

            @* Not while the read is known to have failed. The alert above already says so, and
               "du har ingen variabellister ennå" beside it answers the same question the other way —
               the reader cannot tell whether they have none or whether we never found out. The two
               branches below are already unreachable then, because a failure leaves _page null. *@
            @if (ListsPending)
            {
                <p class="caption" role="status">@T.ListsLoading</p>
            }
            else if (ListsAnswered && Lists.Count == 0)
            {
                @EmptyPanel(T.NoListsYet)
            }
            else if (ListEmptySaidBelow)
            {
                @EmptyPanel(T.EmptyList)
            }
            else if (EmptyRowsShown)
            {
                <p>@EmptyMessage</p>
            }
            else if (_page is not null)
            {
                @* A real <table>, which the explorer's own list cannot be: munin-explorer-dataitem-main
                   is `display: flex` in Stiler, and flex on a table strips its semantics
                   (VariableSearch.razor:530). Nothing in helsedata dresses a SAVED list, so this one
                   is free of that. The scaffolding it replaces could not stop every row repeating all
                   seven field names — a div has no header to be associated with. *@
                @* Inline, not left to the host: Stiler has no rule for this name, and undrawn the
                   table scrolls the host's whole page. `position` is what makes the box the containing
                   block that clips the rows' absolutely positioned labels. Only the focus ring is the
                   host's. *@
                <div class="munin-explorer-list-scroll"
                     style="overflow-x:auto;position:relative"
                     role="region"
                     tabindex="0"
                     aria-labelledby="@ListHeadingId"
                     @ref="_listRegion">
                    <table class="munin-explorer-data-list" aria-labelledby="@ListHeadingId">
                        <thead>
                            <tr class="munin-explorer-data-list__item__row--header">
                                <th scope="col" class="munin-explorer-dataitem-header__name">@T.ColumnVariable</th>
                                <th scope="col" class="munin-explorer-dataitem-header__code">@T.FieldCode</th>
                                <th scope="col" class="munin-explorer-dataitem-header__source">@T.FieldSource</th>
                                <th scope="col" class="munin-explorer-dataitem-header__dataCollection">@T.FieldDataCollection</th>
                                <th scope="col" class="munin-explorer-dataitem-header__theme">@T.FieldVariableGroup</th>
                                <th scope="col" class="munin-explorer-dataitem-header__dataType">@T.FieldDataType</th>
                                <th scope="col" class="munin-explorer-dataitem-header__period">@T.FieldDataPeriod</th>
                                <th scope="col" class="munin-explorer-dataitem-header__kodeverk">@T.FieldKodeverk</th>
                                <th scope="col" class="munin-explorer-dataitem-header__statistikk">@T.FieldStatistics</th>
                                <th scope="col" class="munin-explorer-dataitem-header__desiredData">@T.FieldDesiredData</th>

                                @* A control column with no visible heading, the shape Kelda's expand
                                   column uses: every button under it says "Fjern" already, and a
                                   screen reader arriving in the column has nothing else to hear. *@
                                <th scope="col"><span class="screenreader-only">@T.ColumnRemove</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _page.Items)
                            {
                                <tr class="munin-explorer-data-list__item">

                                    @* An orphaned entry keeps its place, so the paging totals stay
                                       honest; RowName decides in one place what it reads as, because
                                       the remove button is named from these very words. <th scope=row>
                                       the way Kelda's table does, and with no class:
                                       munin-explorer-dataitem-main__name is `display: inline-flex`,
                                       which a table header cell cannot be. *@
                                    @* The name is the row's disclosure; it never disables, as pressing it again is how the panel closes.
                                       An orphan has no variable to open, so its name stays text. *@
                                    <th scope="row">
                                        @if (IsOrphan(item))
                                        {
                                            <span class="munin-explorer-dataitem-main__column__text"
                                                  id="@RowNameId(item)">@RowName(item)</span>
                                        }
                                        else
                                        {
                                            <button class="hd-button-reset"
                                                    type="button"
                                                    aria-expanded="@Expanded(IsOpen(item))"
                                                    aria-controls="@RowPanelControls(item)"
                                                    @onclick="e => ToggleRowFromNameAsync(item, e)">
                                                <span class="@RowChevron(item)" aria-hidden="true"></span>
                                                <span class="munin-explorer-dataitem-main__column__text"
                                                      id="@RowNameId(item)"
                                                      lang="@CatalogueLang(item.VariableName)">@RowName(item)</span>
                                            </button>
                                        }
                                    </th>

                                    @* The six columns the result list draws too and the two coverage
                                       columns only a list draws, built by the cell helper both call —
                                       written out here as well, they could gain an attribute in one
                                       place and not the other without anything failing. *@
                                    @Cells(item)

                                    @* Rendered from the draft rather than from the item, which keeps a
                                       text the API refused in the field instead of reverting it under
                                       the reader. The column header names the COLUMN; this span names
                                       the field, which a control still owes on its own (WCAG 4.1.2). *@
                                    <td class="munin-explorer-dataitem-main__desiredData" data-label="@T.FieldDesiredData">
                                        <span class="screenreader-only" id="@DesiredDataLabelId(item)">@T.FieldDesiredData</span>
                                        <input type="text"
                                               value="@DesiredDataOf(item)"
                                               aria-labelledby="@DesiredDataLabelledBy(item)"
                                               aria-invalid="@DesiredDataInvalid(item)"
                                               aria-describedby="@DesiredDataDescribedBy(item)"
                                               @onchange="e => SaveDesiredDataAsync(item.VariableId, e.Value?.ToString())" />
                                    </td>

                                    @* "Fjern" on every button in the column, so the accessible name
                                       has to say which row (WCAG 4.1.2). Two elements rather than one
                                       aria-label, because each half is in its own language — see
                                       RemoveLabelledBy, which decides the order and why. *@
                                    <td data-label="@T.ColumnRemove">
                                        <button class="hd-button-square button-square--ghost-blue"
                                                type="button"
                                                id="@RemoveButtonId(item)"
                                                aria-labelledby="@RemoveLabelledBy(item)"
                                                @onclick="() => RemoveAsync(item.VariableId)">@T.RemoveFromThisList</button>
                                    </td>
                                </tr>

                                @if (IsOpen(item))
                                {
                                    <tr>
                                        <td colspan="@OwnListColumnCount">@RowPanel(item)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @* The list is as long as the reader made it, and the endpoint is paged. A view that
                   fetched page one and called it the list would show the first 25 and hide the rest
                   without saying so. *@
                @if (TotalPages > 1)
                {
                    <div class="munin-explorer-pagination"
                         role="navigation"
                         aria-label="@T.Pagination">
                        @* The content wrapper is where the layout lives (host.css:1609), and the
                           disabled styling is scoped to it. Without it the buttons get no flex row and
                           the unavailable state draws nothing.

                           aria-disabled, not disabled: a disabled button at the end of the list drops
                           focus to <body>, which a sighted keyboard user has no sign of. The clamp in
                           GoToPageAsync is what makes the press inert. Same rule as the result list. *@
                        <div class="munin-explorer-pagination-content">
                            <button class="hd-button-square button-square--ghost"
                                    type="button"
                                    aria-label="@T.PreviousLabel"
                                    aria-disabled="@AriaDisabled(_pageNumber > 1)"
                                    @onclick="() => GoToPageAsync(_pageNumber - 1)">@T.Previous</button>

                            @* The same numbered run the result list draws, from the same renderer.
                               This pager wears the same two class names, so it had the same unstyled
                               shape and is the same defect twice (Fhi.Metadata-ejcbi). *@
                            @PageNumbers.Write(this, _pageNumber, TotalPages, GoToPageAsync, T.GoToPageLabel, T.CurrentPageLabel)

                            <button class="hd-button-square button-square--ghost"
                                    type="button"
                                    aria-label="@T.NextLabel"
                                    aria-disabled="@AriaDisabled(_pageNumber < TotalPages)"
                                    @onclick="() => GoToPageAsync(_pageNumber + 1)">@T.Next</button>
                        </div>
                    </div>
                }
            }
        </ChildContent>
    </DetailPage>
}

@code {
    // helsedata's own empty state. The button only where the explorer can take the reader to its
    // search; a list standing alone on a host page says where to go and offers nothing it cannot do.
    private RenderFragment EmptyPanel(string title) => @<div class="emptystate">
        @DetailBlocks.Heading(Math.Clamp(TitleLevel + 1, 1, 6), title, "emptystate__title")
        <div class="emptystate__body"><p>@T.EmptyListHint</p></div>
        @if (ShowSearch is { } search)
        {
            <button class="hd-button-square button-square--secondary" type="button"
                    @onclick="search.ShowAsync">@T.GoToSearch</button>
        }
    </div>;
}

@code {
    // A snapshot somebody shared: its own name, the same table and pager as an own list, and
    // nothing that writes — no remove, no desired data, no rename, delete or share.
    private RenderFragment SharedListView => @<text>
        <DetailPage ViewRoot="" ViewMain=""
                    Eyebrow="@(_sharedList is null ? null : T.SharedListEyebrow)"
                    data-munin-explorer-version="@ExplorerVersion.Current">
            <Header>
                <div class="munin-explorer-page__header">
                    @DetailBlocks.Heading(TitleLevel, SharedListName, "headline headline-s margin--bottom",
                                          ListHeadingId)

                    @if (_sharedList is not null)
                    {
                        <p class="caption">@T.ListVariableCount(_sharedList.Items.Count)</p>
                    }
                </div>
            </Header>
            <ChildContent>
                <div>
                    @if (_sharedList is not null && IsAuthenticated)
                    {
                        <button class="hd-button-square button-square--primary"
                                type="button"
                                id="@SaveSharedToggleId"
                                aria-expanded="@Expanded(_savingShared)"
                                @onclick="ToggleSavingSharedFromControl">@T.SaveSharedList</button>
                    }

                    <button class="hd-button-square button-square--ghost-blue"
                            type="button"
                            @onclick="CloseSharedListAsync">@T.CloseSharedList</button>
                </div>

                @* Text, not a login control, for the reason VariableSearch gives beside its tabs. *@
                @if (_sharedList is not null && !IsAuthenticated)
                {
                    <p class="caption">@T.SignInToSaveSharedList</p>
                }

                @if (_savingShared && IsAuthenticated && _sharedList is not null)
                {
                    <div>
                        <label class="form-element__label" for="@SaveSharedNameId">@T.SaveSharedListName</label>
                        <input type="text"
                               id="@SaveSharedNameId"
                               aria-invalid="@(SaveNameMessage is null ? null : "true")"
                               aria-describedby="@(SaveNameMessage is null ? null : SaveSharedNameProblemId)"
                               @bind="_saveSharedName"
                               @bind:event="onchange" />
                        <button class="hd-button-square button-square--ghost-blue"
                                type="button"
                                @onclick="SaveSharedListAsync">@T.SaveSharedListSubmit</button>

                        @* In the DOM while the field is, for the reason the alert region below gives. *@
                        <p id="@SaveSharedNameProblemId" role="alert">@SaveNameMessage</p>
                    </div>
                }

                <div role="alert" aria-live="assertive" aria-atomic="true">
                    @(SharedListMessage ?? SaveSharedMessage)
                </div>

                @if (_sharedList is { Items.Count: 0 })
                {
                    <p>@T.EmptyList</p>
                }
                else if (_sharedList is not null)
                {
                    <div class="munin-explorer-list-scroll"
                         style="overflow-x:auto;position:relative"
                         role="region"
                         tabindex="0"
                         aria-labelledby="@ListHeadingId">
                        <table class="munin-explorer-data-list" aria-labelledby="@ListHeadingId">
                            <thead>
                                <tr class="munin-explorer-data-list__item__row--header">
                                    <th scope="col" class="munin-explorer-dataitem-header__name">@T.ColumnVariable</th>
                                    <th scope="col" class="munin-explorer-dataitem-header__code">@T.FieldCode</th>
                                    <th scope="col" class="munin-explorer-dataitem-header__source">@T.FieldSource</th>
                                    <th scope="col" class="munin-explorer-dataitem-header__dataCollection">@T.FieldDataCollection</th>
                                    <th scope="col" class="munin-explorer-dataitem-header__theme">@T.FieldVariableGroup</th>
                                    <th scope="col" class="munin-explorer-dataitem-header__dataType">@T.FieldDataType</th>
                                    <th scope="col" class="munin-explorer-dataitem-header__period">@T.FieldDataPeriod</th>
                                    <th scope="col" class="munin-explorer-dataitem-header__kodeverk">@T.FieldKodeverk</th>
                                    <th scope="col" class="munin-explorer-dataitem-header__statistikk">@T.FieldStatistics</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in SharedPageItems)
                                {
                                    <tr class="munin-explorer-data-list__item" @key="item.VariableId">
                                        <th scope="row">
                                            <span class="munin-explorer-dataitem-main__column__text"
                                                  id="@RowNameId(item)"
                                                  lang="@CatalogueLang(item.VariableName)">@RowName(item)</span>
                                        </th>
                                        @Cells(item)
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (SharedTotalPages > 1)
                    {
                        <div class="munin-explorer-pagination"
                             role="navigation"
                             aria-label="@T.Pagination">
                            <div class="munin-explorer-pagination-content">
                                <button class="hd-button-square button-square--ghost"
                                        type="button"
                                        aria-label="@T.PreviousLabel"
                                        aria-disabled="@AriaDisabled(_sharedPageNumber > 1)"
                                        @onclick="() => GoToSharedPageAsync(_sharedPageNumber - 1)">@T.Previous</button>

                                @PageNumbers.Write(this, _sharedPageNumber, SharedTotalPages, GoToSharedPageAsync, T.GoToPageLabel, T.CurrentPageLabel)

                                <button class="hd-button-square button-square--ghost"
                                        type="button"
                                        aria-label="@T.NextLabel"
                                        aria-disabled="@AriaDisabled(_sharedPageNumber < SharedTotalPages)"
                                        @onclick="() => GoToSharedPageAsync(_sharedPageNumber + 1)">@T.Next</button>
                            </div>
                        </div>
                    }
                }
            </ChildContent>
        </DetailPage>
    </text>;

    // The chassis's action row, which this surface alone did not fill: the picker and the download
    // sat loose in the flow while the other three put their actions here. A fragment rather than
    // child content so it can be withheld — see HasActions, and DetailPage.razor:22.
    private RenderFragment ActionRow => @<text>
        @* The picker is only a choice when there is one to make. With a single list it
           would be a control whose every option is already selected. *@
        @if (Lists.Count > 1)
        {
            <label>
                @T.ChooseList
                <select value="@_shownList" @onchange="ChooseListAsync" @ref="_listPicker">
                    @* Every option says what its list holds, which is what makes
                       helsedata's own overview readable at a glance — see ListOption. *@
                    @foreach (var list in Lists)
                    {
                        <option value="@list.Id" selected="@(list.Id == _shownList)">@ListOption(list)</option>
                    }
                </select>
            </label>
        }

        @* Only when there is something to download. A button that exports an empty list would
           produce a file with a header row and nothing under it. *@
        @if (_page is not null && _page.TotalCount > 0)
        {
            @* Folded, so three controls do not stand across a row meant for actions. The user
               agent owns this toggle, which is why there is no handler and no aria-expanded. *@
            <details>
                <summary>@T.DownloadList</summary>

                @* A named group, not just a visual one: three controls that only make sense
                   together, and a screen reader moving between them otherwise hears three
                   unrelated widgets. Named as the fold is, so the fold says what it opens. *@
                <div role="group" aria-label="@T.DownloadList">
                    <label>
                        <input type="checkbox"
                               checked="@_includeKodeverk"
                               @onchange="e => _includeKodeverk = e.Value is true" />
                        @T.IncludeKodeverk
                    </label>

                    @* Two formats, two buttons. aria-disabled while a download is in flight
                       rather than disabled, for the reason the pager gives: disabling the
                       element that has focus drops focus to <body>. *@
                    <button class="hd-button-square button-square--ghost-blue"
                            type="button"
                            aria-disabled="@AriaDisabled(!_downloading)"
                            @onclick="() => DownloadAsync(ExportFormat.Xlsx)">@T.DownloadXlsx</button>

                    <button class="hd-button-square button-square--ghost-blue"
                            type="button"
                            aria-disabled="@AriaDisabled(!_downloading)"
                            @onclick="() => DownloadAsync(ExportFormat.Csv)">@T.DownloadCsv</button>
                </div>
            </details>
        }
    </text>;
}

@code {
    // Eleven: the name, nine columns and the remove button. The panel row spans all of them.
    private const int OwnListColumnCount = 11;

    private string RowChevron(VariableListItem item) =>
        IsOpen(item)
            ? "icon icon-keyboard-arrow-up munin-explorer-dataitem-main__expand-icon"
            : "icon icon-keyboard-arrow-down munin-explorer-dataitem-main__expand-icon";

    // The search panel's classes, so Stiler dresses both panels alike and no new name is invented.
    private RenderFragment RowPanel(VariableListItem item) => @<div class="munin-explorer-meta munin-explorer-detail"
                                                                   id="@RowPanelId(item)"
                                                                   role="region"
                                                                   aria-labelledby="@RowPanelHeadingId(item)"
                                                                   aria-busy="@Expanded(_openLoading)">
        @RowPanelHeading(item)

        <p class="@RowPanelStatusClass" role="status" aria-live="polite" aria-atomic="true">@RowPanelStatus</p>

        @if (_openDetail is { } detail)
        {
            <dl class="munin-explorer-meta__grid munin-explorer-meta__grid-2">
                <div>
                    <dt class="headline headline-xxs margin--none">@T.FieldDescription</dt>
                    @if (RowPanelDescription(detail) is { } description)
                    {
                        <dd lang="no">@CatalogueMarkdown.Render(description)</dd>
                    }
                    else
                    {
                        <dd>@T.NotSpecified</dd>
                    }
                </div>

                <div>
                    <dt class="headline headline-xxs margin--none">@T.FieldDataPeriod</dt>
                    <dd>@RowPanelPeriod(item, detail)</dd>
                </div>

                <div>
                    <dt class="headline headline-xxs margin--none">@T.FieldSource</dt>
                    <dd class="munin-explorer-breadcrumb">@RowPanelTrail(detail)</dd>
                </div>

                @if (RowPanelVariabelgrupper(detail) is { } groups)
                {
                    <div>
                        <dt class="headline headline-xxs margin--none">@T.FieldVariableGroup</dt>
                        <dd lang="no">@groups</dd>
                    </div>
                }
            </dl>

            @RowPanelTabs(item, detail)
        }

        @if (VariableHref?.Invoke(item) is { } link)
        {
            <div role="group" aria-labelledby="@RowShareHeadingId(item)">
                <p class="headline headline-xxs margin--none" id="@RowShareHeadingId(item)">@T.ShareVariable</p>
                <button class="hd-button-square button-square--ghost margin-right margin-bottom"
                        type="button"
                        @onclick="() => CopyVariableLinkAsync(link)">@T.CopyVariableLink</button>
                <a class="hd-button-square button-square--ghost margin-right margin-bottom"
                   href="@VariableMailTo(item, link)">@T.SendVariableByEmail</a>
                <p class="caption" role="status" aria-live="polite" aria-atomic="true">@_linkStatus</p>

                @if (_linkNotCopied)
                {
                    <label class="form-element__label" for="@RowLinkFieldId(item)">@T.VariableLinkLabel</label>
                    <input type="text" id="@RowLinkFieldId(item)" readonly value="@link" />
                }
            </div>
        }
    </div>;

    // The same value as the row's column: one draft, one save, one refusal for both fields.
    private RenderFragment RowDesiredDataField(VariableListItem item) => @<div>
        <label class="form-element__label" for="@RowDesiredDataId(item)">@T.FieldDesiredData</label>
        <p class="caption" id="@RowDesiredDataHintId(item)">@T.DesiredDataHint</p>
        <textarea id="@RowDesiredDataId(item)"
                  rows="4"
                  value="@DesiredDataOf(item)"
                  aria-invalid="@DesiredDataInvalid(item)"
                  aria-describedby="@RowDesiredDataDescribedBy(item)"
                  @onchange="e => SaveDesiredDataAsync(item.VariableId, e.Value?.ToString())"></textarea>
    </div>;

    // Saved when the field is left, like Ønskede data; the counter follows each keystroke.
    private RenderFragment RowNotesField(VariableListItem item) => @<div>
        <label class="form-element__label" for="@RowNotesId(item)">@T.NotesLabel</label>
        <textarea id="@RowNotesId(item)"
                  rows="6"
                  maxlength="@NotesMaxLength"
                  value="@_notesDraft"
                  aria-invalid="@NotesInvalid"
                  aria-describedby="@RowNotesDescribedBy(item)"
                  @oninput="e => _notesDraft = e.Value?.ToString() ?? string.Empty"
                  @onchange="e => SaveNotesAsync(item, e.Value?.ToString())"></textarea>
        <p class="caption" id="@RowNotesCountId(item)">@T.NotesCount(_notesDraft.Length, NotesMaxLength)</p>
        <p class="@NotesStatusClass" id="@RowNotesStatusId(item)" role="status" aria-live="polite" aria-atomic="true">@NotesStatus</p>
    </div>;
}
