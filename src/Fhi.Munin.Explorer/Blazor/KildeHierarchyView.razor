@namespace Fhi.Munin.Explorer.Blazor

<div class="munin-explorer-hierarchy" aria-busy="@(_loading ? "true" : "false")">
    <p class="caption" role="status">@Status</p>
    @if (_failed)
    {
        <button type="button" class="hd-button-square button-square--ghost-blue"
                disabled="@_loading" @onclick="LoadAsync">@T.HierarchyRetry</button>
    }
    @if (!_loading && !_failed && _nodes.Count > 0)
    {
        @Nodes(_nodes)
    }
</div>
