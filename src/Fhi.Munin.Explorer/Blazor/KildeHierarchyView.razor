@namespace Fhi.Munin.Explorer.Blazor

@* lang, for a hierarchy mounted on its own under a host lang that need not follow the reader (WCAG 3.1.2). *@
<div class="munin-explorer-hierarchy" lang="@ReaderLanguage.Of(Language)" aria-busy="@(_loading ? "true" : "false")">
    <p class="caption" role="status">@Status</p>
    @if (_retryShown)
    {
        <button type="button" class="hd-button-square button-square--ghost-blue munin-explorer-retry"
                aria-disabled="@(CanRetry ? null : "true")" @onclick="RetryAsync">@T.HierarchyRetry</button>
    }
    @if (!_loading && !_failed && _nodes.Count > 0)
    {
        @Nodes(_nodes)
    }
</div>
