@namespace Fhi.Munin.Explorer.Blazor

@if (Kilde is { } kilde)
{
    <DetailPage ViewRoot="munin-explorer-kilde"
                ViewMain="munin-explorer-kilde__main"
                Trail="@PageTrail"
                TrailLabel="@T.TrailLabel"
                Eyebrow="@KildetypeLabel"
                Actions="@Actions"
                Facts="@HeroFacts"
                StickyName="@StickyNamed.Text"
                StickyNameLang="@StickyNameLang"
                StickyCode="@StickyCode"
                Contents="@DetailToc.Column(Toc, T.HeadingContents)">
        <Header>

            @* The name block, under the kildetype as Skuld's top has it (Fhi.Metadata-4ggs9, which
               brings back what Fhi.Metadata-pnn4w took out). *@
            <div class="munin-explorer-kilde__header">
                @{ var named = T.Named(kilde.PreferredTerm, kilde.Code); }

                @* The catalogue holds one name, in Norwegian, so it is marked when the reader is not - and
                   not when the catalogue left the name empty and this is the code standing in for it. *@
                @DetailBlocks.Heading(HeadingLevel, named.Text, "headline headline-s margin--bottom",
                                      HeadingId, CatalogueProperties.Foreign(named.Norwegian, Reader))

                @* The code is left out where the heading above has already fallen back to it: the code
                   twice, stacked, is what a naive fallback draws. (Fhi.Metadata-w13lk) *@
                @if (CodeLine is { } line)
                {
                    <p class="caption margin--none munin-explorer-kilde__identifiers">@line</p>
                }

                @* Norwegian whatever the reader's language: the catalogue stores one description. *@
                @if (Description is { } description)
                {
                    @DetailBlocks.Prose(description.Lead, "ingress munin-explorer-kilde__description",
                                        CatalogueProperties.Foreign("no", Reader))

                    @* In the DOM while folded, so the page holds the whole text; Folded is null where it fits.
                       The inline display is because Stiler's `div { display: block }` outranks [hidden]. *@
                    @if (description.Folded is { } folded)
                    {
                        <div id="@DescriptionRestId" class="munin-explorer-kilde__description-rest"
                             hidden="@(!_descriptionOpen)" style="@(_descriptionOpen ? null : "display:none")">
                            @DetailBlocks.Prose(folded, "ingress munin-explorer-kilde__description",
                                                CatalogueProperties.Foreign("no", Reader))
                        </div>
                        <button type="button" class="hd-button-reset munin-explorer-kilde__description-toggle"
                                aria-expanded="@(_descriptionOpen ? "true" : "false")"
                                aria-controls="@DescriptionRestId"
                                @onclick="ToggleDescription">
                            @(_descriptionOpen ? T.DescriptionShowLess : T.DescriptionReadMore)
                        </button>
                    }
                }

                @if (JumpToVariables is not null || JumpToDataCollections is not null)
                {
                    <p class="margin--none munin-explorer-kilde__jumps">
                        @if (JumpToVariables is { } variables)
                        {
                            <a href="@VariablesHref">@variables<span aria-hidden="true"> →</span></a>
                        }
                        @* A visible gap with any stylesheet: Stiler 0.1.182 sets the two links flush (Fhi.Metadata-47hlq). *@
                        @if (JumpToVariables is not null && JumpToDataCollections is not null)
                        {
                            <span aria-hidden="true">&nbsp;&nbsp;·&nbsp;&nbsp;</span>
                        }
                        @if (JumpToDataCollections is { } collections)
                        {
                            <a href="@JumpHref(DetailSectionIds.DataCollections)">@collections<span aria-hidden="true"> →</span></a>
                        }
                    </p>
                }
            </div>
        </Header>
        <ChildContent>

            @* One pass, in the order BuildLayout resolved: nothing about which sections there are
               or where they go is decided here. `block` rather than `section`, because @section
               opens an MVC Razor directive before it is ever read as a loop variable. *@
            @foreach (var block in Layout)
            {
                <DetailSection Id="@block.Id">
                    @DetailBlocks.Heading(BlockLevel, block.Heading, "headline headline-s",
                                          language: block.HeadingLanguage)
                    @block.Body
                </DetailSection>
            }

            @* Whatever the explorer using this view puts after this view's own blocks. This
               component never learns which explorer that is: the named sections carry their own
               id and heading, and the fragment after them is drawn as given. *@
            @DetailBlocks.NamedSections(NamedSections, BlockLevel)
            @Sections
        </ChildContent>
    </DetailPage>
}
