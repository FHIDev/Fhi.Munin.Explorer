@namespace Fhi.Munin.Explorer.Blazor

@if (Kilde is { } kilde)
{
    <DetailPage ViewRoot="munin-explorer-kilde"
                ViewMain="munin-explorer-kilde__main"
                Eyebrow="@T.EyebrowKilde"
                Trail="@PageTrail"
                TrailLabel="@T.TrailLabel"
                Actions="@Actions"
                Facts="@HeroFacts"
                StickyName="@StickyNamed.Text"
                StickyNameLang="@StickyNameLang"
                StickyCode="@StickyCode"
                Contents="@DetailToc.Column(Toc, T.HeadingContents)">
        <Header>

            @* The name block. Runa puts the identifiers under the name rather than beside it, and the
               kildetype as a tag away from both — it is a category, not part of what this source is
               called. *@
            <div class="munin-explorer-kilde__header">
                @{ var named = T.Named(kilde.PreferredTerm, kilde.Code); }

                @* The catalogue holds one name, in Norwegian, so it is marked when the reader is not - and
                   not when the catalogue left the name empty and this is the code standing in for it. *@
                @DetailBlocks.Heading(HeadingLevel, named.Text, "headline headline-s margin--bottom",
                                      HeadingId, CatalogueProperties.Foreign(named.Norwegian, Reader))

                @* Not when the heading above has already fallen back to it: the code twice, stacked, is
                   what a naive fallback draws. (Fhi.Metadata-w13lk) *@
                @if (named.Norwegian && Identifiers is { } identifiers)
                {
                    <p class="caption margin--none munin-explorer-kilde__identifiers">@identifiers</p>
                }

                @if (!string.IsNullOrWhiteSpace(kilde.Kildetype))
                {
                    @* `tag` was here, on the theory that it was Stiler's badge class. helsedata defines
                       no `.tag` at all — their badges are `taglist`/`taglistitem`, and even those are
                       only styled inside `.listcontainer .listitemholder .taglist`, which never matches
                       this markup. The kildetype class below is ours and carries the whole badge. *@
                    <p class="munin-explorer-kilde__kildetype">@T.KildeTypeLabel(kilde.Kildetype, kilde.Kildetype)</p>
                }

                @if (!string.IsNullOrWhiteSpace(kilde.Description))
                {
                    @* Norwegian whatever the reader's language: the catalogue stores one description,
                       authored with markdown links and line breaks (FHIDev/Munin#5385). *@
                    <p class="ingress munin-explorer-kilde__description" lang="@CatalogueProperties.Foreign("no", Reader)">
                        @CatalogueMarkdown.Render(kilde.Description)
                    </p>
                }
            </div>
        </Header>
        <ChildContent>

            @* One pass, in the order BuildLayout resolved: nothing about which sections there are
               or where they go is decided here. `block` rather than `section`, because @section
               opens an MVC Razor directive before it is ever read as a loop variable. *@
            @foreach (var block in Layout)
            {
                <DetailSection Id="@block.Id">
                    @DetailBlocks.Heading(BlockLevel, block.Heading, "headline headline-s",
                                          language: block.HeadingLanguage)
                    @block.Body
                </DetailSection>
            }

            @* Whatever the explorer using this view puts after this view's own blocks. This
               component never learns which explorer that is: the named sections carry their own
               id and heading, and the fragment after them is drawn as given. *@
            @DetailBlocks.NamedSections(NamedSections, BlockLevel)
            @Sections
        </ChildContent>
    </DetailPage>
}
