@using Fhi.Munin.Explorer.Contracts
@* The tree is the APG tree with checkable items (aria-checked, a roving tab stop); the tabs follow the panel's own APG
   tabs. Classes only: a host's stylesheet indents the levels and lines up the columns. *@
<div class="margin-bottom" role="group" aria-labelledby="@Id("heading")">
    <p class="headline headline-xxs margin--none" id="@Id("heading")">@T.PickerHeading</p>

    @if (Tabs.Count > 1)
    {
        <div class="munin-explorer-meta__tabs" role="tablist" aria-label="@T.PickerTabsLabel" @onkeydown="TabKeyAsync">
            @for (var i = 0; i < Tabs.Count; i++)
            {
                var index = i;
                var selected = index == Math.Clamp(_tab, 0, Tabs.Count - 1);
                <div @key="KodeverkKey.Of(Tabs[index])" class="@(selected ? "munin-explorer-meta__tab munin-explorer-meta__tab--active" : "munin-explorer-meta__tab")">
                    <button class="hd-button-reset" type="button" role="tab" id="@Id($"tab-{index}")"
                            aria-selected="@(selected ? "true" : "false")" aria-controls="@Id("panel")"
                            tabindex="@(selected ? 0 : -1)" @ref="_tabButtons[index]"
                            @onclick="() => SelectTabAsync(index)"><span lang="@CatalogueLang">@TabName(Tabs[index])</span></button>
                </div>
            }
        </div>
    }

    <div id="@Id("panel")" role="@(Tabs.Count > 1 ? "tabpanel" : null)" aria-labelledby="@(Tabs.Count > 1 ? Id($"tab-{Math.Clamp(_tab, 0, Tabs.Count - 1)}") : null)">
        @if (Current is { } link)
        {
            var state = StateOf(link);
            var top = state.TopBranch;
            @if (top is { Failed: true })
            {
                <p class="caption">@T.PickerLoadError</p>
                <button class="hd-button-square button-square--ghost" type="button" @onclick="() => RetryAsync(link, Top)">@T.PickerRetry</button>
            }
            else if (top is not { Loaded: true })
            {
                <p class="caption">@T.PickerLoading</p>
            }
            else
            {
                @if (state.IsLarge)
                {
                    <div class="margin-bottom">
                        <label class="form-element__label" for="@Id("search")">@T.PickerSearchLabel</label>
                        <p class="caption" id="@Id("search-hint")">@T.PickerSearchHint</p>
                        <input id="@Id("search")" type="search" autocomplete="off" maxlength="100" aria-describedby="@Id("search-hint")"
                               value="@state.Query" @oninput="e => QueryChanged(e, link)"
                               @onkeydown="e => SearchKeyAsync(e, link)" />
                    </div>

                    @if (state.Searched is not null && state.Hits.Count > 0)
                    {
                        var activeHit = ActiveCode(state, HitsSection);
                        @if (state.Hits.Count < state.HitTotal)
                        {
                            <p class="caption">@T.PickerShowingHits(state.Hits.Count, state.HitTotal)</p>
                        }
                        <div class="munin-explorer-page__actions">
                            <button class="hd-button-square button-square--ghost" type="button" aria-disabled="@(_saving ? "true" : "false")" @onclick="() => ChooseHitsAsync(link)">@T.PickerChooseHits</button>
                            <button class="hd-button-square button-square--ghost" type="button" aria-disabled="@(_saving ? "true" : "false")" @onclick="() => ClearHitsAsync(link)">@T.PickerClearHits</button>
                        </div>
                        <ul class="munin-explorer-codetree" role="tree" aria-label="@T.PickerHits(state.HitTotal)" aria-multiselectable="true"
                            @onkeydown="e => TreeKeyAsync(e, link, HitsSection)">
                            @foreach (var hit in state.Hits)
                            {
                                @TreeRow(link, state, HitsSection, hit, 1, activeHit)
                            }
                        </ul>
                    }
                }

                var active = ActiveCode(state, TreeSection);
                <p class="headline headline-xxs margin--none" id="@Id("tree")">@T.PickerTreeHeading</p>
                <ul class="munin-explorer-codetree" role="tree" aria-labelledby="@Id("tree")" aria-multiselectable="true"
                    @onkeydown="e => TreeKeyAsync(e, link, TreeSection)">
                    @foreach (var hit in top.Codes)
                    {
                        @TreeRow(link, state, TreeSection, hit, 1, active)
                    }
                </ul>
                @if (top.Codes.Count < top.Total)
                {
                    <p class="caption">@T.PickerShowingLevel(top.Codes.Count, top.Total)</p>
                }
            }
        }
    </div>

    @if (_choices.Count > 0)
    {
        <p class="form-element__label margin--none" id="@Id("chosen")">@(_union is { } codes ? T.PickerSelectedCodes(codes) : T.PickerChosen)</p>
        <ul class="munin-explorer-data-list" aria-labelledby="@Id("chosen")">
            @foreach (var choice in _choices)
            {
                <li @key="choice.Value">@SummaryLine(choice)</li>
            }
        </ul>
    }

    <p class="caption" tabindex="-1" @ref="_counter">@T.PickerChoiceCount(_choices.Count, MaxChoices)</p>
    @if (Full)
    {
        <p class="caption">@T.PickerFull(MaxChoices)</p>
    }

    @* Present from the first render, so a late answer (a search, a refusal) is a change a screen reader reads. *@
    <p class="caption" role="status" aria-live="polite" aria-atomic="true">@_status</p>
    <p class="caption" role="alert" aria-atomic="true">@_alert</p>

    <div class="munin-explorer-page__actions">
        <button class="hd-button-square button-square--primary" type="button" aria-disabled="@(_saving ? "true" : "false")" @onclick="SaveAsync">@T.PickerSave</button>
        <button class="hd-button-square button-square--ghost" type="button" @onclick="CancelAsync">@T.PickerCancel</button>
    </div>
</div>

@code {
    private static string TabName(KodeverkLink link) =>
        string.IsNullOrWhiteSpace(link.DisplayName) ? link.KodeverkReference : link.DisplayName;

    private static string AriaChecked(Tick tick) => tick switch
    {
        Tick.Checked => "true",
        Tick.Mixed => "mixed",
        _ => "false",
    };

    // A box drawn as a character, so the state shows where no stylesheet draws one; hidden from a screen reader,
    // which hears aria-checked instead.
    private static string Box(Tick tick) => tick switch
    {
        Tick.Checked => "☑",
        Tick.Mixed => "▣",
        _ => "☐",
    };

    // From the API's «utgått», which holds only when the code and all under it have expired; a leaf adds its year.
    private string ExpiredMark(KodeverkCodeHit hit) =>
        hit.Expired ? $" ({T.PickerExpired(hit.HasChildren || hit.IsGroup ? null : hit.ValidTo?.Year)})" : "";

    private bool CanReveal(Choice choice) =>
        choice.Value.Kind is DesiredCodeKinds.Code or DesiredCodeKinds.Node && Tabs.Any(link => SameList(choice, link));

    // One code in the tree: its own line (the expand arrow in its own column, the box, the code, the name cut by the
    // host's stylesheet but whole in the markup), then the level under it once it is opened.
    private RenderFragment TreeRow(KodeverkLink link, ListState state, string section, KodeverkCodeHit hit, int level, string? active)
    {
        var tick = TickOf(link, state, hit);
        var open = hit.HasChildren && state.OpenIn(section).Contains(hit.Value);
        var branch = open ? state.Branches.GetValueOrDefault(hit.Value) : null;
        var id = RowId(section, hit.Value);
        var count = OfCount(link, hit, tick);
        var key = RowKey(section, hit.Value);
        return @<li @key="hit.Value" role="treeitem" id="@id" aria-labelledby="@($"{id}-label")" aria-level="@level"
                    aria-checked="@AriaChecked(tick)" aria-expanded="@(hit.HasChildren ? (open ? "true" : "false") : null)"
                    aria-disabled="@(_saving ? "true" : null)" tabindex="@(hit.Value == active ? 0 : -1)" @ref="_rows[key]">
            <div class="munin-explorer-codetree__row" @onclick="e => RowPressAsync(e, link, section, hit)">
                <span class="munin-explorer-codetree__toggle" aria-hidden="true"
                      @onclick="e => TogglePressAsync(e, link, section, hit)" @onclick:stopPropagation="true">@(hit.HasChildren ? (open ? "▾" : "▸") : "")</span>
                <span class="munin-explorer-codetree__box" aria-hidden="true">@Box(tick)</span>
                <span id="@($"{id}-label")"><span class="munin-explorer-codetree__code">@hit.Value</span>@(" ")<span class="munin-explorer-codetree__name" lang="@CatalogueLang" title="@hit.Name">@hit.Name</span>@ExpiredMark(hit)@if (count is not null)
                    {
                        @(" ")<span class="munin-explorer-codetree__count">@count</span>
                    }</span>
            </div>
            @if (branch is { Failed: true })
            {
                <p class="caption">@T.PickerBranchError @(" ")<button class="hd-button-reset" type="button" @onclick="() => RetryAsync(link, hit.Value)">@T.PickerRetry</button></p>
            }
            else if (branch is { Loaded: true })
            {
                <ul class="munin-explorer-codetree__group" role="group">
                    @foreach (var child in branch.Codes)
                    {
                        @TreeRow(link, state, section, child, level + 1, active)
                    }
                </ul>
                @if (branch.Codes.Count < branch.Total)
                {
                    <p class="caption">@T.PickerShowingLevel(branch.Codes.Count, branch.Total)</p>
                }
            }
            else if (open)
            {
                <p class="caption">@T.PickerLoading</p>
            }
        </li>;
    }

    // A line of the read-only summary: the code opens the tree to it. Only a range the tree has no block for can be
    // removed here, since nothing in the tree stands for it.
    private RenderFragment SummaryLine(Choice choice) => @<span>
        @if (IsOlderRange(choice))
        {
            var words = Describe(T, choice.Value, choice.Name, choice.ToName);
            @($"{words} ({T.PickerOlderChoice}){(choice.Count is { } n ? $" ({T.PickerCodeCount(n)})" : "")}")
            @(" ")<button class="hd-button-square button-square--ghost" type="button" aria-disabled="@(_saving ? "true" : "false")" @onclick="() => RemoveAsync(choice)">@T.PickerRemove(words)</button>
        }
        else
        {
            @if (CanReveal(choice))
            {
                <button class="hd-button-reset" type="button" aria-label="@T.PickerShowInTree(choice.Value.Code)" @onclick="() => RevealAsync(choice)">@choice.Value.Code</button>
            }
            else
            {
                @choice.Value.Code
            }
            @if (!string.IsNullOrWhiteSpace(choice.Name))
            {
                @(" ")<span lang="@CatalogueLang">@choice.Name</span>
            }
            @(choice.Value.Kind == DesiredCodeKinds.Node ? $", {T.PickerAllUnder}{(choice.Count is { } c ? $" ({c})" : "")}" : "")@(choice.Expired ? $" ({T.PickerExpired(null)})" : "")
        }
    </span>;
}
