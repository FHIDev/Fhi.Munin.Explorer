@namespace Fhi.Munin.Explorer.Blazor

<div class="munin-explorer-page @LegacyRoot">

    @Header

    @* The chassis name alone. The legacy `__body` names are a two-track grid on every published
       Stiler, and the contents column below is a second child for that second track to catch —
       which is the 320px rail Fhi.Metadata-35w0p.6 took the main column out of. *@
    <div class="munin-explorer-page__body">

        @* Drawn whether or not anything fills it: the chassis body is a grid whose first track is a
           fixed 250px, so a body holding the main column alone would lay that column out in it. *@
        <div class="munin-explorer-page__toc">@Contents</div>

        <div class="munin-explorer-page__main @LegacyMain">
            @ChildContent
        </div>
    </div>
</div>
