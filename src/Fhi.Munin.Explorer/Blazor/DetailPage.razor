@namespace Fhi.Munin.Explorer.Blazor

@* The splat first, so a caller writing `class` cannot take `munin-explorer-page` off the root
   the layout rules key on: for a duplicated name, Blazor lets the later attribute win. *@
<div @attributes="AdditionalAttributes" class="@RootClasses">

    @* The sticky bar, first so it pins to the top of the page rather than to whatever is above it.
       Rendered `hidden`: the browser module is the only thing that ever shows it, and a reader
       without one loses nothing, because every word in it is already on the page. *@
    @if (Sticky)
    {
        <div id="@StuckbarId" class="munin-explorer-page__stuckbar" hidden aria-hidden="true">
            <div class="munin-explorer-page__stuckbar-inner">

                @* A span, never an h*: the bar repeats the page's own title, and a heading here
                   would announce a second copy of it in the outline a screen reader navigates by. *@
                <span class="munin-explorer-page__stuckbar-name">
                    <span lang="@StickyNameLang">@StickyName</span>
                    @if (!string.IsNullOrWhiteSpace(StickyCode))
                    {
                        <small>@StickyCode</small>
                    }
                </span>

                @* Label and value only — no <small> note, which is the qualifier the hero row has
                   the width for and this one does not. *@
                <dl>
                    @foreach (var fact in ShownStickyFacts)
                    {
                        <div>
                            <dt lang="@fact.LabelLang">@fact.Label</dt>
                            <dd><span lang="@fact.Lang">@fact.Value</span></dd>
                        </div>
                    }
                </dl>

                @* Inert text and nothing else. @Actions is NOT repeated here: a second copy of the
                   caller's fragment is a second tab stop and a duplicate of any id it carries, and
                   the module unhides this bar where neither is inert. *@
            </div>
        </div>
    }

    @* The chrome, above the name block as the mockups arrange it. Every piece of it is drawn only
       when a caller filled it: a trail with no steps, an eyebrow with no word and an unfilled
       action row are each nothing at all rather than an empty box with a margin. *@
    @if (Trail is { Count: > 0 } trail)
    {
        <DetailTrail Steps="trail" Label="@(TrailLabel ?? string.Empty)" />
    }

    @* A <p>, never an h*: the eyebrow names the kind of thing this page is about and is not a
       heading, and one in the outline would put a second title above the real one. *@
    @if (!string.IsNullOrWhiteSpace(Eyebrow))
    {
        <p class="munin-explorer-page__eyebrow">@Eyebrow</p>
    }

    @if (Actions is not null)
    {
        <div class="munin-explorer-page__actions">@Actions</div>
    }

    @Header

    @* The hero row, under the name block and above the body as the mockups arrange it. Drawn only
       where a view named facts the catalogue filled in — an empty <dl> is a pair of rules and a
       row of padding around nothing. *@
    @if (ShownFacts.Count > 0)
    {
        <DetailFacts Facts="ShownFacts" Id="@FactsId" />
    }

    @* The chassis name alone. Every published Stiler lays the three views' own `__body` names out
       as a grid of their own, and two `grid-template-columns` on one element are settled by source
       order rather than by either stylesheet meaning it. *@
    <div class="munin-explorer-page__body">

        @* Only when something fills it: the body's second track is declared for a body that has
           this column, so an unfilled page is one child in one track and costs no rail and no gap
           at any width. *@
        @if (Contents is not null)
        {
            <div class="munin-explorer-page__toc" id="@ContentsId">@Contents</div>
        }

        <div class="@MainClasses">
            @ChildContent
        </div>
    </div>
</div>
