@namespace Fhi.Munin.Explorer.Blazor

@if (Variable is { } variable)
{
    <div class="munin-explorer-whole">

        <div class="munin-explorer-whole__header">
            @{ var named = T.Named(variable.PreferredTerm, variable.Code); }

            @* The catalogue holds one name, in Norwegian, so it is marked when the reader is not - and
               not when the catalogue left the name empty and this is the code standing in for it. *@
            @DetailBlocks.Heading(HeadingLevel, named.Text, "headline headline-s margin--bottom",
                                  HeadingId, CatalogueProperties.Foreign(named.Norwegian, Reader))

            @* Not when the heading above has already fallen back to it. (Fhi.Metadata-w13lk) *@
            @if (named.Norwegian && !string.IsNullOrWhiteSpace(variable.Code))
            {
                <p class="caption margin--none munin-explorer-whole__code">@variable.Code</p>
            }

            @if (!string.IsNullOrWhiteSpace(variable.Description))
            {
                <p class="ingress munin-explorer-whole__description"
                   lang="@CatalogueProperties.Foreign("no", Reader)">@variable.Description</p>
            }
        </div>

        <div class="munin-explorer-whole__body">
            <div class="munin-explorer-whole__main">

                @* Every block below is a <section> carrying a fixed English id, so a contents nav
                   can anchor on it and a link into one is the same link in either language. Where a
                   block can come out empty the wrapper sits INSIDE that check, never around it. *@

                @* Resolved from the payload, exactly as the kilde view resolves a source's. *@
                @if (Groups.Count > 0)
                {
                    <DetailSection Id="@DetailSectionIds.Metadata">
                        @DetailBlocks.Heading(BlockLevel, T.HeadingMetadata, "headline headline-s")

                        @foreach (var group in Groups)
                        {
                            @DetailBlocks.Group(group, GroupLevel, Language)
                        }
                    </DetailSection>
                }

                @* Kodeverk arrives from the explorer that already draws it, rather than being
                   rebuilt here, so this view wraps none of it in a section. *@
                @Sections

                @if (Versions.Count > 0)
                {
                    <DetailSection Id="@DetailSectionIds.Versions">
                        @DetailBlocks.Heading(BlockLevel, T.HeadingVersionHistory, "headline headline-s")
                        @VersionHistory
                    </DetailSection>
                }

                @* Heading and table both, or neither — the block answers the emptiness question
                   itself, and StatisticsBlock.AnyStatistics is that same answer, so this view and
                   the row's Data tab cannot disagree about it. *@
                @if (StatisticsBlock.AnyStatistics(variable))
                {
                    <DetailSection Id="@DetailSectionIds.Statistics">
                        @StatisticsBlock.For(variable, BlockLevel, "headline headline-s", T)
                    </DetailSection>
                }
            </div>

            <aside class="munin-explorer-whole__aside">
                @* Checked although it does not empty under this package's own texts: the row that
                   keeps it full falls back to Texts.NotSpecified, a string the host constructs, so
                   presence follows the content rather than that string. *@
                @if (DetailBlocks.AnyFacts(SourceInformation))
                {
                    <DetailSection Id="@DetailSectionIds.Source">
                        @DetailBlocks.Heading(BlockLevel, T.HeadingSourceInformation, "headline headline-s")
                        @DetailBlocks.Facts(SourceInformation, Language)
                    </DetailSection>
                }

                @if (CatalogueDate.Period(variable.DataFrom, variable.DataTo, Language, T, Dates) is { } period)
                {
                    <DetailSection Id="@DetailSectionIds.DataPeriod">
                        @DetailBlocks.Heading(BlockLevel, T.FieldDataPeriod, "headline headline-s")
                        <p class="margin--none">@period</p>
                    </DetailSection>
                }

                @if (!string.IsNullOrWhiteSpace(variable.DataType))
                {
                    <DetailSection Id="@DetailSectionIds.DataType">
                        @DetailBlocks.Heading(BlockLevel, T.FieldDataType, "headline headline-s")
                        <p class="margin--none">@T.DataTypeLabel(variable.DataType)</p>
                    </DetailSection>
                }

                @if (variable.AllVariabelgrupper.Count > 0)
                {
                    <DetailSection Id="@DetailSectionIds.VariableGroups">
                        @DetailBlocks.Heading(BlockLevel, T.FieldVariableGroups, "headline headline-s")
                        <ul class="munin-explorer-whole__list">
                            @foreach (var group in variable.AllVariabelgrupper)
                            {
                                <li lang="@CatalogueProperties.Foreign("no", Reader)">@group.Name</li>
                            }
                        </ul>
                    </DetailSection>
                }

                @if (variable.AllDatasamlinger.Count > 0)
                {
                    <DetailSection Id="@DetailSectionIds.DataCollections">
                        @DetailBlocks.Heading(BlockLevel, T.HeadingDataCollections, "headline headline-s")
                        <ul class="munin-explorer-whole__list">
                            @foreach (var datasamling in variable.AllDatasamlinger)
                            {
                                <li>
                                    <span lang="@CatalogueProperties.Foreign("no", Reader)">@datasamling.Name</span>
                                    @if (CatalogueDate.Period(datasamling.ValidFrom, datasamling.ValidTo, Language, T, Dates) is { } validity)
                                    {
                                        <span class="caption"> (@validity)</span>
                                    }
                                </li>
                            }
                        </ul>
                    </DetailSection>
                }
            </aside>
        </div>
    </div>
}
