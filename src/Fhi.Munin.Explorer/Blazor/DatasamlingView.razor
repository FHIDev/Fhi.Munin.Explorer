@namespace Fhi.Munin.Explorer.Blazor

@if (Datasamling is { } datasamling)
{
    <DetailPage ViewRoot="munin-explorer-datasamling"
                ViewMain="munin-explorer-datasamling__main"
                Eyebrow="@T.EyebrowDatasamling"
                Trail="@PageTrail"
                TrailLabel="@T.TrailLabel"
                Actions="@Actions"
                Facts="@HeroFacts"
                StickyName="@StickyNamed.Text"
                StickyNameLang="@StickyNameLang"
                StickyCode="@StickyCode"
                Contents="@DetailToc.Column(Toc, T.HeadingContents)">
        <Header>

            @* The name block, arranged as the kilde view arranges a source's: the identifier under the
               name rather than beside it, and the description as prose below both. *@
            <div class="munin-explorer-datasamling__header">
                @{ var named = T.Named(datasamling.PreferredTerm, datasamling.Code); }

                @* The catalogue holds one name, in Norwegian, so it is marked when the reader is not - and
                   not when the catalogue left the name empty and this is the code standing in for it. *@
                @DetailBlocks.Heading(HeadingLevel, named.Text, "headline headline-s margin--bottom",
                                      HeadingId, CatalogueProperties.Foreign(named.Norwegian, Reader))

                @* Not when the heading above has already fallen back to it. (Fhi.Metadata-w13lk) *@
                @if (named.Norwegian && !string.IsNullOrWhiteSpace(datasamling.Code))
                {
                    <p class="caption margin--none munin-explorer-datasamling__identifiers">@datasamling.Code</p>
                }

                @DetailBlocks.Prose(Description, "ingress munin-explorer-datasamling__description",
                                    CatalogueProperties.Foreign("no", Reader))
            </div>
        </Header>
        <ChildContent>

            @* One pass, in the order BuildLayout resolved. Which sections this page has, what
               they are called and where they sit is the catalogue's placement to decide — no
               section list is written here, which is the whole of Fhi.Metadata-lr6yh. *@
            @foreach (var block in Layout)
            {
                <DetailSection Id="@block.Id" @key="block.Id">
                    @DetailBlocks.Heading(BlockLevel, block.Heading, "headline headline-s",
                                          language: block.HeadingLanguage)
                    @block.Body
                </DetailSection>
            }

            @* Whatever the explorer using this view puts after this view's own blocks. This
               component never learns which explorer that is: the named sections carry their own
               id and heading, and the fragment after them is drawn as given. *@
            @DetailBlocks.NamedSections(NamedSections, BlockLevel)
            @Sections
        </ChildContent>
    </DetailPage>
}

@code {
    // A real table rather than a list of divs: it is what ties a cell to its column heading for a
    // screen reader, and an undrawn one still lines its columns up where an unknown class name
    // draws nothing at all. Which section it lands in is BuildLayout's.
    private RenderFragment VariablesBlock => @<text>
        <p class="caption" role="status">@VariablesStatus</p>

        @* Never `disabled`: the offer is spent, and taking the focus of whoever just pressed it
           away to <body> is a worse answer than a button that says so. *@
        @if (_variablesRetryShown)
        {
            <button type="button" class="hd-button-square button-square--ghost-blue munin-explorer-retry"
                    aria-disabled="@(CanRetryVariables ? null : "true")"
                    @onclick="RetryVariablesAsync">@T.VariablesRetry</button>
        }

        @if (AnyVariables)
        {
            <table class="munin-explorer-datasamling__variabler">

                @* The table's own name, and the API's total rather than the payload's count: a
                   reader hearing one page of twenty is owed how many there are altogether. *@
                <caption class="screenreader-only">@T.VariablesCaption(_variablesTotal)</caption>
                <thead>
                    <tr>
                        <th scope="col">@T.FieldCode</th>
                        <th scope="col">@T.FieldName</th>
                        <th scope="col">@T.FieldDescription</th>
                        <th scope="col">@T.FieldDataType</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var variable in _variables)
                    {
                        <tr @key="variable.Id">
                            @* The code, not the name: it is the one value of the row that is stable,
                               unique and language-free, so it is what the other cells are about. *@
                            <th scope="row">@variable.Code</th>
                            <td lang="@CatalogueProperties.Foreign("no", Reader)">@variable.PreferredTerm</td>
                            <td lang="@CatalogueProperties.Foreign("no", Reader)">@CatalogueMarkdown.Render(variable.Description)</td>

                            @* The stored value is a code — live rows carry "2" — and a legacy row
                               carries a word. DataTypeLabel canonicalises before it looks up, so the
                               two land on one name and neither reaches the page raw. *@
                            <td>@DataTypeName(variable.DataType)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (NoVariables)
        {
            <p class="munin-explorer-datasamling__variabler-tom">@T.VariablesEmpty</p>
        }

        @if (VariablePageCount > 1)
        {
            @* The result list's own pager, class names and all. A div with role="navigation" rather
               than a <nav> so it can be named apart from the host page's own landmarks. *@
            <div class="munin-explorer-pagination" role="navigation" aria-label="@T.Pagination">
                <div class="munin-explorer-pagination-content">
                    <button class="hd-button-square button-square--ghost"
                            type="button"
                            aria-label="@T.PreviousLabel"
                            aria-disabled="@AriaDisabled(_variablesPage > 1)"
                            @onclick="() => GoToVariablePageAsync(_variablesPage - 1)">@T.Previous</button>

                    @PageNumbers.Write(this, _variablesPage, VariablePageCount, GoToVariablePageAsync,
                                       T.GoToPageLabel, T.CurrentPageLabel)

                    <button class="hd-button-square button-square--ghost"
                            type="button"
                            aria-label="@T.NextLabel"
                            aria-disabled="@AriaDisabled(_variablesPage < VariablePageCount)"
                            @onclick="() => GoToVariablePageAsync(_variablesPage + 1)">@T.Next</button>
                </div>
            </div>
        }
    </text>;
}
