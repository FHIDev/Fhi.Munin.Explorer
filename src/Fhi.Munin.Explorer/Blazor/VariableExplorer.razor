@namespace Fhi.Munin.Explorer.Blazor

@* The variabelutforsker as a reader meets it: search on one tab, their own variable lists on the
   other, and both of them in the address bar. The two tabs are Runa's, in Runa's words
   (explorer.tabs.search_results / explorer.tabs.variable_list) — see client/app/components/
   ExplorerTabs.tsx in Fhi.Metadata, which is what runa.munin.skytest.fhi.no/explorer draws.

   No @page and no @rendermode, like everything else here; but this one owns the query string, so
   it must be mounted interactively. A host that wants to own its own address bar, or its own page
   furniture, composes VariableSearch and VariableListView itself.

   No class name of its own. The tablist wears the same four names the detail panel's tabs already
   wear — Stiler has rules for all four, and inventing a second tab family would ship names with no
   rule behind them until somebody wrote one. *@

<div class="munin-explorer-meta__tabs"
     role="tablist"
     aria-label="@T.Title"
     @onkeydown="TabKey">
    @foreach (var tab in Tabs)
    {
        <div class="@TabClass(tab)" @key="tab">
            <button class="hd-button-reset"
                    type="button"
                    role="tab"
                    id="@TabId(tab)"
                    aria-selected="@(tab == _tab ? "true" : "false")"
                    aria-controls="@TabPanelId(tab)"
                    tabindex="@(tab == _tab ? 0 : -1)"
                    @onclick="() => _tab = tab">@TabLabel(tab)</button>
        </div>
    }
</div>

@* Both panels stay in the DOM and the inactive one is hidden, rather than only the selected one
   being built: a VariableListView rebuilt on every tab switch would refetch its way back to the
   state it already shares, and show nothing while that fetch was out. `hidden` needs no CSS. *@
<div class="munin-explorer-meta__tab-content"
     role="tabpanel"
     id="@TabPanelId(ExplorerTab.Search)"
     aria-labelledby="@TabId(ExplorerTab.Search)"
     tabindex="0"
     hidden="@(_tab != ExplorerTab.Search)">
    <VariableSearch @bind-Search="_state.Search"
                    @bind-Filter="_state.Filter"
                    @bind-Sort="_state.Sort"
                    @bind-Direction="_state.Direction"
                    @bind-Page="_state.Page"
                    @bind-PageSize="_state.PageSize"
                    @bind-SelectedVariableId="_state.SelectedVariableId"
                    IsAuthenticated="@IsAuthenticated"
                    HeadingLevel="@HeadingLevel"
                    Language="@Language" />
</div>

<div class="munin-explorer-meta__tab-content"
     role="tabpanel"
     id="@TabPanelId(ExplorerTab.VariableList)"
     aria-labelledby="@TabId(ExplorerTab.VariableList)"
     tabindex="0"
     hidden="@(_tab != ExplorerTab.VariableList)">
    <VariableListView Language="@Language"
                      IsAuthenticated="@IsAuthenticated"
                      HeadingLevel="@HeadingLevel" />
</div>
