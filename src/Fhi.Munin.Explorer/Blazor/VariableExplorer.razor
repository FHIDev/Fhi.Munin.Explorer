@namespace Fhi.Munin.Explorer.Blazor

@* The variabelutforsker whole: the search, the reader's own lists behind Runa's second tab, and
   the view in the address bar. The tabs belong to VariableSearch, which is what puts them below
   the search box and the filters rather than around them.

   No @page and no @rendermode, like everything else here; but this one owns the query string, so
   it must be mounted interactively. *@

@* The address the mirror last wrote, for the drill-in views' contents nav — see
   KildeExplorer.razor, where the same value is cascaded for the same reason. *@
@* The bindings write the state this search was mounted with: one a remount replaced, finishing
   a slow request after Back, writes into the old object rather than over the restored list. *@
@{ var state = _state; }
<CascadingValue Name="@DetailToc.PageAddressName" Value="@PageAddress">
    <VariableSearch @key="_arrival"
                    @bind-Search="state.Search"
                    @bind-Filter="state.Filter"
                    @bind-Sort="state.Sort"
                    @bind-Direction="state.Direction"
                    @bind-Page="state.Page"
                    @bind-PageSize="state.PageSize"
                    @bind-SelectedVariableId="state.SelectedVariableId"
                    @bind-SelectedDatasamlingId="state.SelectedDatasamlingId"
                    @bind-SelectedInstrumentId="state.SelectedInstrumentId"
                    ShareCode="@state.ShareCode"
                    IsAuthenticated="@IsAuthenticated"
                    HeadingLevel="@HeadingLevel"
                    Lede="@Lede"
                    Language="@Language"
                    DatasamlingVariablesHref="@DatasamlingVariablesHref"
                    InstrumentHref="@InstrumentHref"
                    InstrumentVariablesHref="@InstrumentVariablesHref"
                    ExplorerPageUrl="@ExportPageUrl"
                    VariableHref="@SearchVariableHref"
                    VariableList="@ReaderLists"
                    VariableListFilters="@ReaderListFilters" />
</CascadingValue>

@code {
    // Passed as a fragment rather than mounted beside the search, so the list sits inside the tab
    // panel and still shares the circuit's VariableListState with the save button.
    private RenderFragment ReaderLists => @<VariableListView Language="@Language"
                                                            IsAuthenticated="@IsAuthenticated"
                                                            HeadingLevel="@ListLevel"
                                                            ShareCode="@_state.ShareCode"
                                                            ShareCodeChanged="@OnShareCodeChanged"
                                                            SharedListHref="@SharedListHref"
                                                            ExplorerPageUrl="@ExportPageUrl"
                                                            VariableHref="@VariableHref" />;

    // The list's own filter panel, which cannot travel inside the fragment above: it belongs in the
    // filter column, and the fragment above is drawn in the result one.
    private RenderFragment ReaderListFilters => @<VariableListFilters Language="@Language"
                                                                      IsAuthenticated="@IsAuthenticated"
                                                                      HeadingLevel="@ListLevel" />;

    // The list tab sits under the explorer's title like the search's own panels do (VariableSearch.RowLevel): at the
    // title's level a host passing 1 got three h1s, the title, «Filter» and the list's name (Fhi.Metadata-l9l2n.136).
    private int ListLevel => Math.Clamp(Math.Clamp(HeadingLevel, 1, 6) + 1, 1, 6);
}
