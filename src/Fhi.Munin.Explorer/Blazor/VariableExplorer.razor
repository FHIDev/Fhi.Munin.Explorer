@namespace Fhi.Munin.Explorer.Blazor

@* The variabelutforsker whole: the search, the reader's own lists behind Runa's second tab, and
   the view in the address bar. The tabs belong to VariableSearch, which is what puts them below
   the search box and the filters rather than around them.

   No @page and no @rendermode, like everything else here; but this one owns the query string, so
   it must be mounted interactively. *@

<VariableSearch @bind-Search="_state.Search"
                @bind-Filter="_state.Filter"
                @bind-Sort="_state.Sort"
                @bind-Direction="_state.Direction"
                @bind-Page="_state.Page"
                @bind-PageSize="_state.PageSize"
                @bind-SelectedVariableId="_state.SelectedVariableId"
                IsAuthenticated="@IsAuthenticated"
                HeadingLevel="@HeadingLevel"
                Language="@Language"
                VariableList="@ReaderLists" />

@code {
    // Passed as a fragment rather than mounted beside the search, so the list sits inside the tab
    // panel and still shares the circuit's VariableListState with the save button.
    private RenderFragment ReaderLists => @<VariableListView Language="@Language"
                                                            IsAuthenticated="@IsAuthenticated"
                                                            HeadingLevel="@HeadingLevel" />;
}
