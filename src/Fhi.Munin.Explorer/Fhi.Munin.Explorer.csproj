<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Description>Munin's variable explorer as an embeddable Blazor component, with the typed client that feeds it. Renders inside a modern Blazor Web App and inside legacy Blazor Server (AddServerSideBlazor + MapBlazorHub, as used by Optimizely) alike — no router, no @page, no @rendermode of its own. Ships no CSS: it emits the host's own class names so it inherits the surrounding site's styling instead of fighting it. Call AddMuninExplorer to register the client; calls are anonymous unless an IMuninExplorerTokenProvider is registered first, in which case the user's access token is forwarded on every request.</Description>
    <PackageTags>munin;fhi;helsedata;blazor;razor-class-library;metadata;variabler</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <!-- Abstractions is what the components consume; the implementation is AddLogging's own package
         and AddMuninExplorer calls it. Not a widening: Microsoft.Extensions.Http above has depended
         on Microsoft.Extensions.Logging at this same version since the first release. -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- The client, its handlers and CatalogueProperties are internal on purpose: a host renders a
         component and talks to IMuninExplorerClient, and does not resolve the catalogue's
         properties itself. The tests drive all three directly - the client against a stub
         HttpMessageHandler, and the property rules head-on, because those rules were measured
         rather than designed and are worth testing as rules instead of inferring from markup. -->
    <InternalsVisibleTo Include="Fhi.Munin.Explorer.Tests" />
  </ItemGroup>

  <!-- Which version a host actually serves, at _content/Fhi.Munin.Explorer/version.json. Written by the
       build from the package's own version, never by hand: a stale file would be worse than none.
       Backslashes on purpose: from the second build the SDK's own glob has the file as wwwroot\version.json
       on Windows, and Remove compares the spelling. With a forward slash it did not match there, the file
       was included twice and the build failed on "two assets targeting the same path". MSBuild converts
       the backslash on Linux (measured on Windows, SDK 10.0.401, Fhi.Metadata-l9l2n.123). -->
  <Target Name="WriteVersionFile" BeforeTargets="AssignTargetPaths;ResolveProjectStaticWebAssets">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\wwwroot\version.json" Lines="{&quot;package&quot;:&quot;$(PackageId)&quot;,&quot;version&quot;:&quot;$(PackageVersion)&quot;}" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content Remove="wwwroot\version.json" />
      <Content Include="wwwroot\version.json" />
    </ItemGroup>
  </Target>

</Project>
